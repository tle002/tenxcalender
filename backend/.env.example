# Backend config. Copy to backend/.env and fill in.
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000

# true = seeded mock calendar (default, works with no Google setup)
USE_MOCK=true

# LLM (used from step 2). Model is swappable here.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Google OAuth (used only when USE_MOCK=false)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
